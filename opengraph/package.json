{
  "name": "atbbs-opengraph",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "lint": "oxlint . --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@atbbs/atproto": "1.4.2",
    "@atbbs/core": "1.4.2",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.0"
  }
}
